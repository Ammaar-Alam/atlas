ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ATLAS_ALLOW_LIVE=false

# Coinbase Advanced Trade API credentials.
# Required only when submitting real orders with:
#   atlas paper --execution-venue coinbase --data-source coinbase --no-dry-run
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSPHRASE=

ATLAS_LOG_LEVEL=INFO

ATLAS_BACKTEST_MAX_POSITION_NOTIONAL_USD=10000
ATLAS_PAPER_MAX_POSITION_NOTIONAL_USD=1000
